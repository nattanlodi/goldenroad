# ============================================================
# Credenciais do Supabase para o modo "Worlds ao Vivo" ONLINE
# ============================================================
# Copie este arquivo para `.env.local` (NÃO comitar o .local) e preencha com os
# valores do seu projeto Supabase: Project Settings → API.
#
# São chaves PÚBLICAS (a anon key pode ir no bundle). A segurança vem das RLS,
# e aqui nem usamos tabelas — só Realtime (canais efêmeros). NUNCA coloque a
# service_role key aqui.
#
# Sem estas variáveis, o jogo funciona offline e o online cai no transporte
# local (abas do mesmo navegador), bom para teste.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_PUBLIC_KEY
